[Unit]
Description=Usage dashboard collector push (no repo needed; uses published npm package)

[Service]
Type=oneshot
# Requires once per machine: Bun (or Node 22+) plus API_URL, INGEST_TOKEN,
# DEVICE_ID, DEVICE_LABEL in the service environment (e.g. EnvironmentFile=).
ExecStart=/usr/bin/env bunx ai-usage-collector@latest --push --days 30
