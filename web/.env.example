# ---- Web (public page; needed for local dev) ----
NEXT_PUBLIC_API_URL=https://your-app.vercel.app
NEXT_PUBLIC_READ_TOKEN=replace-with-read-token

# ---- API routes (server-side; set in Vercel dashboard for prod) ----
# Persistence: Turso (libSQL). Local dev falls back to file:./data/usage.db when unset.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

INGEST_TOKEN=replace-with-openssl-rand-hex-32
READ_TOKEN=replace-with-a-different-random
CRON_SECRET=replace-with-another-random

# ---- Account sync (server-side, no PC job; optional) ----
# OpenCode usage export (service key oc_sk_... from opencode console).
# When set, the digest cron pulls per-request tokens + actual cost daily.
OPENCODE_SERVICE_KEY=
# Defaults to https://opencode.ai/console if unset.
OPENCODE_CONSOLE_URL=

# ---- Digest (server-side; optional but recommended) ----
CRON_TZ=Asia/Kolkata
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
DIGEST_EMAIL_TO=
ALERT_THRESHOLD_USD=20
